#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        backspacehold {
            bindings = <&kp BACKSPACE>;
            key-positions = <45 44>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // ┌──────┬──────┬──────┬──────┬──────┬──────┐               ┌──────────┬──────┬──────┬──────┬──────┬──────┐
            // │ ESC  │  1   │  2   │  3   │  4   │  5   │               │  6       │  7   │  8   │  9   │  0   │  -   │
            // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┬──────┤ ├──────────┼──────┼──────┼──────┼──────┼──────┼──────┤
            // │ TAB  │  Q   │  W   │  E   │  R   │  T   │ LCTL │ LGUI │ │  Y       │  U   │  I   │  O   │  P   │  \   │
            // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤ ├──────────┼──────┼──────┼──────┼──────┼──────┼──────┤
            // │ LSFT │  A   │  S   │  D   │  F   │  G   │ LALT │ SPC  │ │  H       │  J   │  K   │  L   │  ;   │  '   │
            // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤ ├──────────┼──────┼──────┼──────┼──────┼──────┼──────┤
            // │ LCTL │  Z   │  X   │  C   │  V   │  B   │CMD/BS│ RET  │ │  N       │  M   │  ,   │  .   │  /   │ LALT │
            // └──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┘ └──────────┴──────┴──────┴──────┴──────┴──────┘

            bindings = <
&kp TILDE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &mt LEFT_META BACKSPACE  &lt 1 SPACE  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH  &kp ESCAPE  &kp A  &kp S  &kp D  &kp F  &kp G  &kp LALT  &kp RET  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LC(LA(LG(LSHFT)))  &kp RCTRL  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
            >;
        };

        layer_1 {
            bindings = <
&studio_unlock  &kp F1  &kp F2  &kp F3  &trans  &bt BT_SEL 0  &trans  &kp LPAR  &kp RPAR  &trans  &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &sys_reset  &bt BT_SEL 1  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &trans  &trans  &trans  &trans  &kp F7  &kp F8  &kp F9  &trans  &bt BT_CLR_ALL  &trans  &trans  &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &bootloader  &trans  &trans  &trans  &kp LBRC  &kp RBRC  &trans  &trans  &trans
            >;
        };
    };
};
